@model NovoAcessoViewModel

@{
    ViewData["Title"] = "Solicitar Novo Acesso";
}

<div class="text-center my-4">
    <h1 class="display-2">
        <i class="bi bi-droplet-fill text-warning"></i> ConverTank
    </h1>
    <p class="text-secondary">Painel de Monitoramento de Combustíveis</p>
</div>

<form asp-action="NovoAcesso" method="post" class="shadow">
    <h3 class="text-center mb-4 text-white">Criar Nova Conta</h3>

    <div class="mb-3">
        <label for="nomeInput" class="form-label">Nome Completo</label>
        <input asp-for="Nome" type="text" class="form-control" id="nomeInput" placeholder="Ex: João Silva" required>
    </div>

    <div class="mb-3">
        <label for="loginInput" class="form-label">Nome de Usuário (Login)</label>
        <input asp-for="Login" type="text" class="form-control" id="loginInput" placeholder="Ex: joao.silva" required>
    </div>
    
    <div class="mb-3">
        <label for="senhaInput" class="form-label">Senha</label>
        <input asp-for="Senha" type="password" class="form-control" id="senhaInput" placeholder="Crie uma senha forte" required>
    </div>
    
    <div class="mb-3">
        <label for="confirmarSenhaInput" class="form-label">Confirmar Senha</label>
        <input asp-for="ConfirmarSenha" type="password" class="form-control" id="confirmarSenhaInput" placeholder="Repita a senha criada" required>
    </div>
    
    <div class="d-grid gap-2 mt-4">
        <button class="btn btn-primary" type="submit">
            <i class="bi bi-check-circle-fill"></i> Salvar e Registrar
        </button>
        <a class="btn btn-secondary" asp-action="Login" asp-controller="Auth">
            <i class="bi bi-arrow-left"></i> Voltar ao Login
        </a>
    </div>
</form>