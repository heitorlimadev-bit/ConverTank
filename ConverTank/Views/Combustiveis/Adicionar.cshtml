@model Combustivel


<div class="text-center">

    <h1 class="display-2">Novo Combustível</h1>

</div>


<form asp-action="Adicionar" method="post">

    <div class="mb-3">
        <label for="formGroupExampleInput" class="form-label">Nome</label>
