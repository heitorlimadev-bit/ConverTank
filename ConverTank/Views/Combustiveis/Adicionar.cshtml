@model Combustivel

@{
    ViewData["Title"] = "Novo Combustível";
}

<div class="text-center my-4">
    <h1 class="display-2">
        <i class="bi bi-fuel-pump-fill text-warning"></i> Novo Combustível
    </h1>
    <p class="text-secondary">Cadastre novos tipos de combustíveis e derivados</p>
</div>

<form asp-action="Adicionar" method="post" class="shadow">
    <div class="mb-3">
        <label for="nomeInput" class="form-label">Nome do Combustível</label>
        <input asp-for="Nome" type="text" class="form-control" id="nomeInput" placeholder="Ex: Gasolina Aditivada, Diesel S10" required>
    </div>

    <div class="mb-3">
        <label for="fornecedorSelect" class="form-label">Fornecedor Associado</label>
        <select asp-for="FornecedorId" class="form-select" id="fornecedorSelect" required>
            <option value="" disabled selected>-- Selecione um Fornecedor --</option>
            @foreach (var fornecedor in ViewBag.Fornecedores)
            {
                <option value="@fornecedor.Id">@fornecedor.Nome</option>
            }
        </select>
    </div>

    <div class="d-grid gap-2 mt-4">
        <button class="btn btn-primary" type="submit">
            <i class="bi bi-check-lg"></i> Salvar Combustível
        </button>
        <a class="btn btn-secondary" asp-action="Index">
            <i class="bi bi-x-circle"></i> Cancelar e Voltar
        </a>
    </div>
</form>