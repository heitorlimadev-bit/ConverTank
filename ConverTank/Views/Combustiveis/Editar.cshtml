@model Combustivel

@{
    ViewData["Title"] = "Editar Combustível";
}

<div class="text-center my-4">
    <h1 class="display-2">
        <i class="bi bi-pencil-square text-warning"></i> Editar Combustível
    </h1>
    <p class="text-secondary">Edite as informações do combustível selecionado</p>
</div>

<form asp-action="Editar" method="post" class="shadow">
    <input type="hidden" asp-for="Id" />

    <div class="mb-3">
        <label for="nomeInput" class="form-label">Nome do Combustível</label>
        <input asp-for="Nome" type="text" class="form-control" id="nomeInput" required>
    </div>

    <div class="mb-3">
        <label for="fornecedorSelect" class="form-label">Fornecedor Associado</label>
        <select asp-for="FornecedorId" class="form-select" id="fornecedorSelect" required>
            @foreach (var fornecedor in ViewBag.Fornecedores)
            {
                <option value="@fornecedor.Id">@fornecedor.Nome</option>
            }
        </select>
    </div>

    <div class="d-grid gap-2 mt-4">
        <button class="btn btn-primary" type="submit">
            <i class="bi bi-save"></i> Salvar Alterações
        </button>
        <a class="btn btn-secondary" asp-action="Index">
            <i class="bi bi-x-circle"></i> Cancelar e Voltar
        </a>
    </div>
</form>