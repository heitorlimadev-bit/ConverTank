@model Fornecedor

@{
    ViewData["Title"] = "Novo Fornecedor";
}

<div class="text-center my-4">
    <h1 class="display-2">
        <i class="bi bi-truck-flatbed text-warning"></i> Novo Fornecedor
    </h1>
    <p class="text-secondary">Cadastre distribuidores e fornecedores de derivados de petróleo</p>
</div>

<form asp-action="Adicionar" method="post" class="shadow">
    <div class="mb-3">
        <label for="nomeInput" class="form-label">Nome do Fornecedor</label>
        <input asp-for="Nome" type="text" class="form-control" id="nomeInput" placeholder="Ex: Petrobras Distribuidora" required>
    </div>
    
    <div class="mb-3">
        <label for="cnpjInput" class="form-label">CNPJ</label>
        <div class="input-group">
            <span class="input-group-text bg-secondary border-color text-secondary">
                <i class="bi bi-card-text"></i>
            </span>
            <input asp-for="Cnpj" type="text" class="form-control cnpj-mask" id="cnpjInput" placeholder="00.000.000/0000-00" required>
        </div>
    </div>

    <div class="d-grid gap-2 mt-4">
        <button class="btn btn-primary" type="submit">
            <i class="bi bi-check-lg"></i> Salvar Fornecedor
        </button>
        <a class="btn btn-secondary" asp-action="Index">
            <i class="bi bi-x-circle"></i> Cancelar e Voltar
        </a>
    </div>
</form>