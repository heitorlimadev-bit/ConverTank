@model Fornecedor


<div class="text-center">

    <h1 class="display-2">Fornecedor</h1>

</div>


<form asp-action="Editar" method="post">

    <input type="hidden" asp-for="Id" />

    <div class="mb-3">
        <label for="formGroupExampleInput" class="form-label">Nome</label>
        <input asp-for="Nome" type="text" class="form-control" id="formGroupExampleInput">
    </div>
    <div class="mb-3">
        <label for="formGroupExampleInput2" class="form-label">Cnpj</label>
        <input asp-for="Cnpj" type="text" class="form-control" id="formGroupExampleInput2">
    </div>
    <div class="d-grid">

        <button class="btn btn-primary" type="submit">Salvar</button>

    </div>

   
</form>