<div class="text-center">

    <h1 class="display-2">

        Fornecedores

    </h1>

    <div class="card shadow border-0">

        <div class="card-body">

            <div class="table-responsive">

                <table class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th scope="col">Id</th>
                            <th scope="col">Nome</th>
                            <th scope="col">Cnpj</th>
                            <th scope="col"></th>
                        </tr>
                    </thead>
                    <tbody>

                        @foreach (var fornecedor in Model)
                        {
            
                            <tr>
                                <th scope="row">@fornecedor.Id</th>
                                <td>@fornecedor.Nome</td>
                                <td>@fornecedor.Cnpj</td>


                                <td>
                                    <a type="button" class="btn btn-secondary" asp-action="Editar" asp-route-id="@fornecedor.Id">Editar</a>
                                    <a type="button" class="btn btn-danger" asp-action="Apagar" asp-route-id="@fornecedor.Id">Apagar</a>
                                </td>

                    
                            </tr>

                        }


                    </tbody>
                </table>
                <div class="d-grid gap-2">
                    <a class="btn btn-primary" type="button" asp-controller="Fornecedores" asp-action="Adicionar">Adicionar Fornecedor</a>
                    <a class="btn btn-secondary" type="button" asp-controller="Home" asp-action="Index">Voltar</a>
                </div>

            </div>

        </div>

    </div>

</div>