@{
    ViewData["Title"] = "Painel de Controle";
}

<div class="my-4">
    <div class="p-5 mb-4 rounded-3 text-center" style="background: linear-gradient(135deg, rgba(245, 158, 11, 0.1) 0%, rgba(21, 27, 34, 0.8) 100%); border: 1px solid var(--border-color);">
        <h1 class="display-4"><i class="bi bi-droplet-fill text-warning"></i> ConverTank</h1>
        <p class="fs-5 text-secondary">Sistema de Conversão e Monitoramento de Medições para Derivados de Petróleo</p>
        <hr class="my-4 border-secondary">
        <p>Monitore volumes de tanques, gerencie postos, fornecedores, combustíveis e calibração de forma precisa e segura.</p>
        <a class="btn btn-primary btn-lg px-4 mt-2" asp-controller="Postos" asp-action="Index">
            <i class="bi bi-speedometer2"></i> Iniciar Monitoramento
        </a>
    </div>

    <h3 class="mb-4 text-white"><i class="bi bi-grid-1x2-fill text-warning me-2"></i> Centro de Controle</h3>

    <div class="dashboard-grid">
        <a asp-controller="Postos" asp-action="Index" class="text-decoration-none">
            <div class="stat-card">
                <div class="stat-icon"><i class="bi bi-geo-alt-fill"></i></div>
                <div class="stat-info">
                    <span class="stat-label">Postos</span>
                    <span class="stat-value">Gerenciar</span>
                </div>
            </div>
        </a>

        <a asp-controller="Combustiveis" asp-action="Index" class="text-decoration-none">
            <div class="stat-card">
                <div class="stat-icon"><i class="bi bi-fuel-pump-fill"></i></div>
                <div class="stat-info">
                    <span class="stat-label">Combustíveis</span>
                    <span class="stat-value">Modelos</span>
                </div>
            </div>
        </a>

        <a asp-controller="Tanques" asp-action="Index" class="text-decoration-none">
            <div class="stat-card">
                <div class="stat-icon"><i class="bi bi-database-fill"></i></div>
                <div class="stat-info">
                    <span class="stat-label">Tanques</span>
                    <span class="stat-value">Modelos</span>
                </div>
            </div>
        </a>

        <a asp-controller="Fabricantes" asp-action="Index" class="text-decoration-none">
            <div class="stat-card">
                <div class="stat-icon"><i class="bi bi-buildings-fill"></i></div>
                <div class="stat-info">
                    <span class="stat-label">Fabricantes</span>
                    <span class="stat-value">Fábricas</span>
                </div>
            </div>
        </a>

        <a asp-controller="Fornecedores" asp-action="Index" class="text-decoration-none">
            <div class="stat-card">
                <div class="stat-icon"><i class="bi bi-truck-flatbed"></i></div>
                <div class="stat-info">
                    <span class="stat-label">Fornecedores</span>
                    <span class="stat-value">Parceiros</span>
                </div>
            </div>
        </a>
    </div>

    <div class="row mt-4">
        <div class="col-md-6 mb-4">
            <div class="card h-100 shadow border-0">
                <div class="card-body">
                    <h5 class="card-title text-warning"><i class="bi bi-shield-lock me-2"></i> Controle de Acesso</h5>
                    <p class="card-text text-secondary mt-3">Gerencie as permissões e associe usuários aos seus respectivos postos de abastecimento para relatórios restritos.</p>
                    <a class="btn btn-secondary mt-3" asp-controller="Usuarios" asp-action="PermissaoUsuario">
                        <i class="bi bi-key-fill"></i> Ajustar Permissões
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-6 mb-4">
            <div class="card h-100 shadow border-0">
                <div class="card-body">
                    <h5 class="card-title text-warning"><i class="bi bi-info-circle me-2"></i> Informações do Sistema</h5>
                    <p class="card-text text-secondary mt-3">ConverTank calcula automaticamente a cubagem e o volume em litros com base no raio, comprimento e altura medida do líquido.</p>
                    <div class="text-secondary mt-3 small">
                        <i class="bi bi-circle-fill text-warning me-1"></i> Foco em Derivados: Diesel, Gasolina, QAV, e Lubrificantes.
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

