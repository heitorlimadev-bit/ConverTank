@{
    ViewData["Title"] = "Novo Inventário";
    int ano = ViewBag.Ano ?? DateTime.Today.Year;
    int trimestre = ViewBag.Trimestre ?? 1;
}

<div class="text-center my-4">
    <h1 class="display-2">
        <i class="bi bi-clipboard-plus text-warning"></i> Novo Inventário
    </h1>
    <p class="text-secondary">Todos os tanques ativos de todos os postos ativos entram no inventário.
        A data de referência é o último dia do trimestre.</p>
</div>

@if (ViewBag.Erro != null)
{
    <div class="alert alert-danger">@ViewBag.Erro</div>
}

<form asp-action="Novo" method="post" class="shadow">
    @Html.AntiForgeryToken()
    <div class="row g-3">
        <div class="col-md-6">
            <label for="ano" class="form-label">Ano</label>
            <input type="number" id="ano" name="ano" class="form-control" value="@ano" min="2000" max="2100" required />
        </div>
        <div class="col-md-6">
            <label for="trimestre" class="form-label">Trimestre</label>
            <select id="trimestre" name="trimestre" class="form-select" required>
                @for (int t = 1; t <= 4; t++)
                {
                    var fim = Inventario.UltimoDiaDoTrimestre(ano, t);
                    if (t == trimestre)
                    {
                        <option value="@t" selected>@(t)º trimestre (até @fim.ToString("dd/MM"))</option>
                    }
                    else
                    {
                        <option value="@t">@(t)º trimestre (até @fim.ToString("dd/MM"))</option>
                    }
                }
            </select>
        </div>
    </div>

    <div class="d-grid gap-2 mt-4">
        <button class="btn btn-primary" type="submit">
            <i class="bi bi-check-lg"></i> Criar inventário
        </button>
        <a class="btn btn-secondary" asp-action="Index">
            <i class="bi bi-arrow-left"></i> Voltar
        </a>
    </div>
</form>
