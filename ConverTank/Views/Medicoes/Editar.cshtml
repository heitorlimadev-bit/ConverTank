@model Medicao

@{
    ViewData["Title"] = "Editar Medição";
}

<div class="text-center my-4">
    <h1 class="display-2">
        <i class="bi bi-pencil-square text-warning"></i> Editar Medição
    </h1>
    <p class="text-secondary">Ajuste os dados de altura em centímetros para recalcular o volume</p>
    @if (ViewBag.Tanque != null)
    {
        <div class="badge bg-secondary px-3 py-2 fs-6">
            Tanque #@ViewBag.Tanque.Id - @(ViewBag.Tanque.Combustivel?.Nome ?? "Combustível") | Capacidade: @ViewBag.Tanque.Volume L
        </div>
    }
</div>

<form asp-action="Editar" method="post" class="shadow">
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="TanqueId" value="@Model.TanqueId" />

    <div class="mb-3">
        <label for="alturaInput" class="form-label">Altura do Líquido (cm)</label>
        <div class="input-group">
            <span class="input-group-text bg-secondary border-color text-secondary">
                <i class="bi bi-water"></i>
            </span>
            <input asp-for="Altura" type="number" step="any" min="0" class="form-control" id="alturaInput" required>
        </div>
        <small class="text-secondary mt-1 d-block">Medição da régua em centímetros (cm). O volume em litros será recalculado automaticamente.</small>
    </div>
    
    <div class="d-grid gap-2 mt-4">
        <button class="btn btn-primary" type="submit">
            <i class="bi bi-save"></i> Salvar e Recalcular
        </button>
        <a class="btn btn-secondary" asp-action="Index" asp-route-id="@Model.TanqueId">
            <i class="bi bi-arrow-left"></i> Voltar para Medições
        </a>
    </div>
</form>