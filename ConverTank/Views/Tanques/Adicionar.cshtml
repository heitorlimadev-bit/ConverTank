@model Tanque

@{
    ViewData["Title"] = "Novo Modelo de Tanque";
}

<div class="text-center my-4">
    <h1 class="display-2">
        <i class="bi bi-fuel-pump-fill text-warning"></i> Novo Modelo de Tanque
    </h1>
    <p class="text-secondary">Cadastre a especificação do modelo. Depois instale-o em quantos postos quiser, quantas vezes precisar.</p>
</div>

<form asp-action="Adicionar" method="post" class="shadow">
    <div class="mb-3">
        <label for="nomeInput" class="form-label">Nome do modelo <span class="text-secondary">(opcional)</span></label>
        <input asp-for="Nome" class="form-control" id="nomeInput" placeholder="Ex: 15 m³ bipartido Zeppini" />
    </div>

    <div class="mb-3">
        <label for="fabricanteSelect" class="form-label">Fabricante do Tanque</label>
        <select asp-for="FabricanteId" class="form-select" id="fabricanteSelect" required>
            <option value="" disabled selected>-- Selecione o Fabricante --</option>
            @foreach (var fabricante in ViewBag.Fabricantes)
            {
                <option value="@fabricante.Id">@fabricante.Nome</option>
            }
        </select>
    </div>

    <div class="row">
        <div class="col-md-4 mb-3">
            <label for="volumeInput" class="form-label">Volume Nominal (L)</label>
            <input asp-for="Volume" type="number" min="1" class="form-control" id="volumeInput" placeholder="Ex: 15000" required>
        </div>
        <div class="col-md-4 mb-3">
            <label for="comprimentoInput" class="form-label">Comprimento (m)</label>
            <input asp-for="Comprimento" type="number" step="any" min="0.01" class="form-control" id="comprimentoInput" placeholder="Ex: 5.50" required>
        </div>
        <div class="col-md-4 mb-3">
            <label for="diametroInput" class="form-label">Diâmetro (m)</label>
            <input name="Diametro" id="diametroInput" type="number" step="any" min="0.01" class="form-control" placeholder="Ex: 2.50" required>
            <small class="text-secondary mt-1 d-block">O valor será convertido para raio no cálculo.</small>
        </div>
    </div>

    <div class="d-grid gap-2 mt-4">
        <button class="btn btn-primary" type="submit">
            <i class="bi bi-check-lg"></i> Salvar Modelo
        </button>
        <a class="btn btn-secondary" asp-action="Index">
            <i class="bi bi-x-circle"></i> Cancelar e Voltar
        </a>
    </div>
</form>
