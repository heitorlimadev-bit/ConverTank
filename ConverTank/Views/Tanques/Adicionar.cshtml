@model Tanque

@{
    ViewData["Title"] = "Novo Tanque";
}

<div class="text-center my-4">
    <h1 class="display-2">
        <i class="bi bi-fuel-pump-fill text-warning"></i> Novo Tanque de Combustível
    </h1>
    <p class="text-secondary">Cadastre novos tanques de armazenamento associados a este posto</p>
</div>

<form asp-action="Adicionar" method="post" class="shadow">
    <input type="hidden" asp-for="PostoId" value="@ViewBag.PostoId" />

    <div class="mb-3">
        <label for="fabricanteSelect" class="form-label">Fabricante do Tanque</label>
        <select asp-for="FabricanteId" class="form-select" id="fabricanteSelect" required>
            <option value="" disabled selected>-- Selecione o Fabricante --</option>
            @foreach (var fabricante in ViewBag.Fabricantes)
            {
                <option value="@fabricante.Id">@fabricante.Nome</option> 
            }
        </select>
    </div>

    <div class="mb-3">
        <label for="combustivelSelect" class="form-label">Combustível Armazenado</label>
        <select asp-for="CombustivelId" class="form-select" id="combustivelSelect" required>
            <option value="" disabled selected>-- Selecione o Combustível --</option>
            @foreach (var combustivel in ViewBag.Combustiveis)
            {
                <option value="@combustivel.Id">@combustivel.Nome - (@combustivel.Fornecedor.Nome)</option>
            }
        </select>
    </div>

    <div class="row">
        <div class="col-md-4 mb-3">
            <label for="volumeInput" class="form-label">Volume Nominal (L)</label>
            <input asp-for="Volume" type="number" min="1" class="form-control" id="volumeInput" placeholder="Ex: 10000" required>
        </div>
        <div class="col-md-4 mb-3">
            <label for="comprimentoInput" class="form-label">Comprimento (m)</label>
            <input asp-for="Comprimento" type="number" step="any" min="0.01" class="form-control" id="comprimentoInput" placeholder="Ex: 5.50" required>
        </div>
        <div class="col-md-4 mb-3">
            <label for="diametroInput" class="form-label">Diâmetro (m)</label>
            <input name="Diametro" id="diametroInput" type="number" step="any" min="0.01" class="form-control" placeholder="Ex: 2.50" required>
            <small class="text-secondary mt-1 d-block">O valor será convertido para raio no cálculo.</small>
        </div>
    </div>

    <div class="d-grid gap-2 mt-4">
        <button class="btn btn-primary" type="submit">
            <i class="bi bi-check-lg"></i> Salvar Tanque
        </button>
        <a class="btn btn-secondary" asp-action="Index" asp-route-id="@ViewBag.PostoId">
            <i class="bi bi-x-circle"></i> Cancelar e Voltar
        </a>
    </div>
</form>