@model Tanque

@{
    ViewData["Title"] = "Editar Modelo de Tanque";
    int instalacoes = ViewBag.Instalacoes ?? 0;
}

<div class="text-center my-4">
    <h1 class="display-2">
        <i class="bi bi-pencil-square text-warning"></i> Editar Modelo de Tanque
    </h1>
    <p class="text-secondary">Edite as especificações técnicas do modelo</p>
    @if (instalacoes > 0)
    {
        <div class="alert alert-warning d-inline-block">
            <i class="bi bi-exclamation-triangle"></i>
            Este modelo está instalado em <strong>@instalacoes</strong> tanque(s). Alterar as dimensões muda o cálculo de todos eles
            (medições já gravadas não são recalculadas).
        </div>
    }
</div>

<form asp-action="Editar" method="post" class="shadow">
    <input type="hidden" asp-for="Id" />

    <div class="mb-3">
        <label for="nomeInput" class="form-label">Nome do modelo <span class="text-secondary">(opcional)</span></label>
        <input asp-for="Nome" class="form-control" id="nomeInput" />
    </div>

    <div class="mb-3">
        <label for="fabricanteSelect" class="form-label">Fabricante do Tanque</label>
        <select asp-for="FabricanteId" class="form-select" id="fabricanteSelect" required>
            @foreach (var fabricante in ViewBag.Fabricantes)
            {
                <option value="@fabricante.Id">@fabricante.Nome</option>
            }
        </select>
    </div>

    <div class="row">
        <div class="col-md-4 mb-3">
            <label for="volumeInput" class="form-label">Volume Nominal (L)</label>
            <input asp-for="Volume" type="number" min="1" class="form-control" id="volumeInput" required>
        </div>
        <div class="col-md-4 mb-3">
            <label for="comprimentoInput" class="form-label">Comprimento (m)</label>
            <input asp-for="Comprimento" type="number" step="any" min="0.01" class="form-control" id="comprimentoInput" required>
        </div>
        <div class="col-md-4 mb-3">
            <label for="diametroInput" class="form-label">Diâmetro (m)</label>
            <input name="Diametro" id="diametroInput" value="@Model.Diametro.ToString(System.Globalization.CultureInfo.InvariantCulture)" type="number" step="any" min="0.01" class="form-control" required>
            <small class="text-secondary mt-1 d-block">O valor será convertido para raio no cálculo.</small>
        </div>
    </div>

    <div class="d-grid gap-2 mt-4">
        <button class="btn btn-primary" type="submit">
            <i class="bi bi-save"></i> Salvar Alterações
        </button>
        <a class="btn btn-secondary" asp-action="Index">
            <i class="bi bi-x-circle"></i> Cancelar e Voltar
        </a>
    </div>
</form>
