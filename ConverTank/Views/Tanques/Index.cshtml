@model List<Tanque>

@{
    ViewData["Title"] = "Modelos de Tanque";
    bool admin = ViewBag.Administrador == true;
    var br = System.Globalization.CultureInfo.GetCultureInfo("pt-BR");
}

<div class="text-center">
    <h1 class="display-2">
        <i class="bi bi-fuel-pump text-warning me-2"></i> Modelos de Tanque
    </h1>
    <p class="text-secondary fs-5">Cadastre aqui as especificações de cada modelo. Para colocar um modelo em um posto, abra o posto e use “Instalar tanque”.</p>

    @if (TempData["Erro"] != null)
    {
        <div class="alert alert-danger">@TempData["Erro"]</div>
    }

    <div class="card shadow border-0">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th scope="col">Id</th>
                            <th scope="col">Modelo</th>
                            <th scope="col">Fabricante</th>
                            <th scope="col">Capacidade</th>
                            <th scope="col">Diâmetro (m)</th>
                            <th scope="col">Comprimento (m)</th>
                            <th scope="col">Instalado em</th>
                            <th scope="col">Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr><td colspan="8" class="text-secondary">Nenhum modelo cadastrado.</td></tr>
                        }
                        @foreach (var tanque in Model)
                        {
                            var usos = tanque.PostoTanques
                                .Where(pt => pt.Posto != null)
                                .GroupBy(pt => pt.Posto.Nome)
                                .OrderBy(g => g.Key)
                                .Select(g => g.Count() > 1 ? $"{g.Key} ×{g.Count()}" : g.Key)
                                .ToList();
                            <tr>
                                <th scope="row">@tanque.Id</th>
                                <td>@(string.IsNullOrWhiteSpace(tanque.Nome) ? "—" : tanque.Nome)</td>
                                <td>@(tanque.Fabricante?.Nome ?? "-")</td>
                                <td>
                                    <span class="badge bg-warning text-dark px-3 py-2">
                                        @((tanque.Volume / 1000.0).ToString("0.##", br)) m³
                                    </span>
                                    <small class="text-secondary d-block">@tanque.Volume.ToString("N0", br) L</small>
                                </td>
                                <td>@tanque.Diametro.ToString("0.00", br)</td>
                                <td>@tanque.Comprimento.ToString("0.00", br)</td>
                                <td class="text-start small">
                                    @if (usos.Any())
                                    {
                                        <strong>@tanque.PostoTanques.Count tanque(s):</strong> @string.Join(", ", usos)
                                    }
                                    else
                                    {
                                        <span class="text-secondary">não instalado</span>
                                    }
                                </td>
                                <td>
                                    @if (admin)
                                    {
                                        <a class="btn btn-secondary btn-sm" asp-action="Editar" asp-route-id="@tanque.Id">
                                            <i class="bi bi-pencil"></i> Editar
                                        </a>
                                        <a class="btn btn-danger btn-sm" asp-action="Apagar" asp-route-id="@tanque.Id"
                                           onclick="return confirm('Apagar este modelo de tanque?');">
                                            <i class="bi bi-trash"></i> Apagar
                                        </a>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
                <div class="d-grid gap-2 mt-4">
                    @if (admin)
                    {
                        <a class="btn btn-primary" asp-action="Adicionar">
                            <i class="bi bi-plus-circle"></i> Novo modelo de tanque
                        </a>
                    }
                    <a class="btn btn-secondary" asp-controller="Home" asp-action="Index">
                        <i class="bi bi-arrow-left"></i> Voltar
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
