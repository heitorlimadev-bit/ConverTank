@model PermissaoUsuarioVM

<div class="text-center">

    <h1 class="display-4">
        @Model.NomeUsuario
    </h1>

    <div class="card shadow border-0">

        <div class="card-body">

            <form asp-action="SalvarPermissoes">

                <input type="hidden" asp-for="UsuarioId" />

                <div class="form-check mb-3">

                    <input class="form-check-input"
                           asp-for="Administrador" />

                    <label class="form-check-label">
                        Usuário Administrador
                    </label>

                </div>

                <div class="table-responsive">

                    <table class="table table-hover align-middle">

                        <thead class="table-light">

                            <tr>
                                <th>Permitir</th>
                                <th>Id</th>
                                <th>Nome</th>
                                <th>CNPJ</th>
                            </tr>

                        </thead>

                        <tbody>

                            @foreach (var posto in Model.TodosPostos)
                            {
                                <tr>

                                    <td>

                                        <input class="form-check-input"
                                               type="checkbox"
                                               name="PostosPermitidos"
                                               value="@posto.Id"
                                               checked="@Model.PostosPermitidos.Contains(posto.Id)" />

                                    </td>

                                    <td>@posto.Id</td>

                                    <td>@posto.Nome</td>

                                    <td>@posto.Cnpj</td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

                <div class="d-grid gap-2">

                    <button type="submit"
                            class="btn btn-primary">

                        Salvar Permissões

                    </button>

                    <a class="btn btn-secondary"
                           asp-action="PermissaoUsuario">

                        Voltar

                    </a>

                </div>

            </form>

        </div>

    </div>

</div>